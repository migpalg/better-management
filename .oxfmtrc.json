{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 80,
  "ignorePatterns": [
    ".agents/**",
    ".claude/**",
    "pnpm-lock.yaml",
    "skills-lock.json",
    "src/app/styles/globals.css",
    "src/features/common/components/ui/**",
    "src/features/common/utils/cn/cn.ts"
  ]
}
